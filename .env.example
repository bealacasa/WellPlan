# Copia a .env.local. Estas dos variables son PÚBLICAS por diseño (van en el JavaScript de la app):
# la seguridad de los datos la garantizan el login y las políticas RLS de Supabase.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Nunca pongas aquí la clave secreta (sb_secret_...) ni la service_role.
